# Executed during installation/CPack staging, after STAR has been installed.
set(root "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
set(executable "${root}/@CMAKE_INSTALL_LIBEXECDIR@/rnanue/STAR")
set(libdir "${root}/@CMAKE_INSTALL_LIBEXECDIR@/rnanue/lib")
set(notices "${root}/@CMAKE_INSTALL_DATADIR@/rnanue/licenses/STAR")
if(NOT "@RNANUE_STAR_STATIC@")
    if("@CMAKE_SYSTEM_NAME@" STREQUAL "Darwin")
        set(excludes "^/System/Library/" "^/usr/lib/")
    else()
        # glibc and the platform ELF loader remain OS prerequisites. Compiler,
        # OpenMP and compression runtimes are deliberately NOT excluded.
        set(excludes "/ld-linux[^/]*\\.so" "/lib(c|m|pthread|dl|rt|resolv|util)\\.so\\.")
    endif()
    file(GET_RUNTIME_DEPENDENCIES EXECUTABLES "@RNANUE_STAR_EXECUTABLE@"
        RESOLVED_DEPENDENCIES_VAR dependencies UNRESOLVED_DEPENDENCIES_VAR unresolved
        CONFLICTING_DEPENDENCIES_PREFIX conflicts POST_EXCLUDE_REGEXES ${excludes})
    if(unresolved OR conflicts_FILENAMES)
        message(FATAL_ERROR "Cannot package STAR runtimes: unresolved=${unresolved}; conflicts=${conflicts_FILENAMES}")
    endif()
    file(MAKE_DIRECTORY "${libdir}")
    set(packaged "${executable}")
    foreach(dependency IN LISTS dependencies)
        get_filename_component(name "${dependency}" NAME)
        file(COPY_FILE "${dependency}" "${libdir}/${name}")
        file(CHMOD "${libdir}/${name}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
        list(APPEND packaged "${libdir}/${name}")
    endforeach()
    if("@CMAKE_SYSTEM_NAME@" STREQUAL "Darwin")
        foreach(binary IN LISTS packaged)
            if(binary STREQUAL executable)
                set(relative "@loader_path/lib")
            else()
                set(relative "@loader_path")
                get_filename_component(name "${binary}" NAME)
                execute_process(COMMAND "@RNANUE_STAR_INSTALL_NAME_TOOL@" -id "@loader_path/${name}" "${binary}" COMMAND_ERROR_IS_FATAL ANY)
            endif()
            execute_process(COMMAND "@RNANUE_STAR_OTOOL@" -L "${binary}" OUTPUT_VARIABLE linked COMMAND_ERROR_IS_FATAL ANY)
            string(REPLACE "\n" ";" linked "${linked}")
            foreach(line IN LISTS linked)
                if(line MATCHES "^[ \t]+(.+) \\(compatibility")
                    set(old "${CMAKE_MATCH_1}")
                    get_filename_component(name "${old}" NAME)
                    if(EXISTS "${libdir}/${name}")
                        execute_process(COMMAND "@RNANUE_STAR_INSTALL_NAME_TOOL@" -change "${old}" "${relative}/${name}" "${binary}" COMMAND_ERROR_IS_FATAL ANY)
                    endif()
                endif()
            endforeach()
            # All non-system references are now loader-relative. Remove search
            # paths inherited from the compiler/package manager as well.
            execute_process(COMMAND "@RNANUE_STAR_OTOOL@" -l "${binary}"
                OUTPUT_VARIABLE commands COMMAND_ERROR_IS_FATAL ANY)
            string(REPLACE "\n" ";" commands "${commands}")
            set(in_rpath false)
            foreach(line IN LISTS commands)
                if(line MATCHES "cmd LC_RPATH")
                    set(in_rpath true)
                elseif(in_rpath AND line MATCHES "^[ \t]+path (.+) \\(offset [0-9]+\\)")
                    execute_process(COMMAND "@RNANUE_STAR_INSTALL_NAME_TOOL@"
                        -delete_rpath "${CMAKE_MATCH_1}" "${binary}" COMMAND_ERROR_IS_FATAL ANY)
                    set(in_rpath false)
                endif()
            endforeach()
            execute_process(COMMAND "@RNANUE_STAR_CODESIGN@" --force --sign - "${binary}" COMMAND_ERROR_IS_FATAL ANY)
        endforeach()
    else()
        foreach(binary IN LISTS packaged)
            if(binary STREQUAL executable)
                set(relative "$ORIGIN/lib")
            else()
                set(relative "$ORIGIN")
            endif()
            execute_process(COMMAND "@RNANUE_STAR_PATCHELF@" --set-rpath "${relative}" "${binary}" COMMAND_ERROR_IS_FATAL ANY)
        endforeach()
    endif()
endif()
execute_process(COMMAND "${executable}" --version OUTPUT_VARIABLE version
    OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE result)
if(NOT result EQUAL 0 OR NOT version STREQUAL "@RNANUE_STAR_VERSION@")
    message(FATAL_ERROR "Installed STAR failed verification: ${version} (${result})")
endif()
file(SHA256 "${executable}" digest)
file(APPEND "${notices}/build-info.txt" "installed_executable_sha256=${digest}\n")
